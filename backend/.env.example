# NutriVita backend — variables d'environnement (EXEMPLE)
# Copier en `.env` et renseigner les vraies valeurs. NE JAMAIS committer le .env réel.

# --- Coeur ---
NODE_ENV=development
PORT=5000
JWT_SECRET=changeme-genere-une-chaine-aleatoire-longue
FRONTEND_URL=http://localhost:3000

# --- Reconnaissance d'aliments par photo (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Base nutritionnelle USDA FoodData ---
USDA_API_KEY=

# --- Intégration Strava (OAuth2) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5000/api/activity/strava/callback
STRAVA_VERIFY_TOKEN=

# --- Intégration Google Fit / Health Connect (OAuth2) ---
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_REDIRECT_URI=http://localhost:5000/api/health/google-fit/callback
